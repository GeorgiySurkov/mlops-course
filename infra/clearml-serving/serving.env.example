# Copy to serving.env (gitignored) before `make serve`. scripts/deploy_serving.sh fills
# this in automatically (it substitutes this Mac's mDNS name for HOST_ALIAS).
#
# Hosts are as seen FROM the serving containers. We use the Mac's mDNS name
# (<LocalHostName>.local), NOT localhost: the inference container pulls the model weights
# + preprocess from the file server using the URL stored at train/deploy time, so that
# address must be reachable from inside the container. The mDNS name resolves on the host
# (Bonjour) and from Colima containers, and tracks your IP automatically (DHCP-proof) —
# no /etc/hosts, no hardcoded IP.
CLEARML_WEB_HOST=http://HOST_ALIAS:8080
CLEARML_API_HOST=http://HOST_ALIAS:8008
CLEARML_FILES_HOST=http://HOST_ALIAS:8081

CLEARML_API_ACCESS_KEY=
CLEARML_API_SECRET_KEY=

# Serving Service control-task id (output of `clearml-serving create`)
CLEARML_SERVING_TASK_ID=

# Host port for the inference endpoint (8080 is the ClearML web UI)
CLEARML_SERVING_HOST_PORT=8085

# Match the train-time versions so the pickled sklearn pipeline unpickles in the container
CLEARML_EXTRA_PYTHON_PACKAGES=scikit-learn==1.4.2 numpy==1.26.4 scipy==1.13.1 joblib==1.4.2 pandas==2.2.2
