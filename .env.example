# Copy to .env and fill in. The ClearML SDK reads ~/clearml.conf first; these vars
# are used for docker-compose substitution and by the SDK/helpers.

# Self-hosted ClearML server (local docker-compose stack)
CLEARML_API_HOST=http://localhost:8008
CLEARML_WEB_HOST=http://localhost:8080
CLEARML_FILES_HOST=http://localhost:8081

# Credentials: ClearML web UI -> Settings -> Workspace -> Create new credentials,
# or generate headlessly with scripts/create_credentials.sh
CLEARML_API_ACCESS_KEY=
CLEARML_API_SECRET_KEY=
